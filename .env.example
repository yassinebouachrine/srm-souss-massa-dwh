# .env.example — Template à copier vers .env
# ============================================================
# SRM Souss-Massa - Variables d'environnement
# ============================================================

# ─── Environnement ───
ENVIRONMENT=development_local
TIMEZONE=Africa/Agadir

# ─── PostgreSQL (v17) ───
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=srm_datawarehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# ─── Streamlit ───
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# ─── Sécurité (Streamlit auth) ───
# ⚠️  En production, générez une clé aléatoire de 64+ caractères
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-random-64-char-string
TOKEN_EXPIRY_HOURS=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ─── Airflow ───
AIRFLOW_HOME=./airflow_home
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:password@localhost:5432/airflow_metadata

# ─── Jupyter ───
JUPYTER_PORT=8888

# ─── Dossiers données ───
DATA_RAW_FOLDER=./data/raw
DATA_PROCESSED_FOLDER=./data/processed
INX_WATCH_FOLDER=./data/raw/capteurs_inx
INX_PROCESSED_FOLDER=./data/raw/capteurs_inx_processed
PMAC_WATCH_FOLDER=./data/raw/capteurs_pmac
PMAC_PROCESSED_FOLDER=./data/raw/capteurs_pmac_processed