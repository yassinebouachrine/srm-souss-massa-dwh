# ============================================================
# SRM Souss-Massa - Template des Variables d'environnement
# (Fichier d'exemple sécurisé pour Git)
# ============================================================

# ─── Environnement ─────────────────────────────────────────
ENVIRONMENT=development_local
TIMEZONE=Africa/Casablanca

# ─── PostgreSQL DWH ────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=......
POSTGRES_USER=.....
POSTGRES_PASSWORD=your_postgres_password_here

# ─── Streamlit ─────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_THEME_BASE=light
SESSION_TIMEOUT_MINUTES=30

# ─── ETL Paths ─────────────────────────────────────────────
ETL_DATA_ROOT=data
ETL_RAW_PATH=data/raw
ETL_BRONZE_PATH=data/bronze
ETL_SILVER_PATH=data/silver
ETL_REJECTS_PATH=data/rejects
ETL_LOGS_PATH=data/logs
ETL_LOG_LEVEL=INFO

# ─── PCWIN (SQL Server distant) ────────────────────────────
PCWIN_HOST=192....
PCWIN_PORT=.....
PCWIN_DATABASE=.....
PCWIN_USER=your_pcwin_user
PCWIN_PASSWORD=your_pcwin_password
PCWIN_DRIVER=.....
PCWIN_DATE_MIN=2026-01-01
PCWIN_CHUNK_SIZE=100000

# ─── Chemins des sources brutes ─────────────────────────────
PATH_RAW_PMAC=data/raw/pmac
PATH_RAW_GSTCOM=data/raw/gstcom
PATH_RAW_INDICATEURS_RECLAMATIONS=data/raw/indicateurs_reclamations
PATH_RAW_RENDEMENTS=data/raw/rendements
PATH_RAW_REFERENTIELS=data/raw/referentiels

# ─── Airflow - Email / SMTP ────────────────────────────────
AIRFLOW__EMAIL__EMAIL_BACKEND=airflow.utils.email.send_email_smtp
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=your_email@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=your_smtp_app_password
AIRFLOW__SMTP__SMTP_MAIL_FROM=your_email@gmail.com