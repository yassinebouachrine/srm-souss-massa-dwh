# ============================================================
# SRM Souss-Massa - Variables d'environnement
# ============================================================
# Copier ce fichier en .env et remplir vos valeurs

# Environnement
ENVIRONMENT=development_local
TIMEZONE=Africa/Agadir

# PostgreSQL (deja installe v17)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=srm_datawarehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1342

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Airflow
AIRFLOW_HOME=./airflow_home
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:1342@localhost:5432/airflow_metadata

# Jupyter
JUPYTER_PORT=8888

# Dossiers donnees
DATA_RAW_FOLDER=./data/raw
DATA_PROCESSED_FOLDER=./data/processed
INX_WATCH_FOLDER=./data/raw/capteurs_inx
INX_PROCESSED_FOLDER=./data/raw/capteurs_inx_processed
PMAC_WATCH_FOLDER=./data/raw/capteurs_pmac
PMAC_PROCESSED_FOLDER=./data/raw/capteurs_pmac_processed

# Auth Streamlit (dev simple)
AUTH_MODE=simple
DEV_USERNAME=admin
DEV_PASSWORD=admin123
