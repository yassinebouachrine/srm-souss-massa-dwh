# ============================================================
# SRM Souss-Massa - Configuration DOCKER PRODUCTION (SRM)
# ============================================================

# ─── Environnement ─────────────────────────────────────────
ENVIRONMENT=production
TIMEZONE=Africa/Casablanca

# ─── PostgreSQL DWH (Conteneur Docker) ─────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=srm_datawarehouse
POSTGRES_USER=srm_admin
POSTGRES_PASSWORD=srm_prod_password_2026

# ─── Streamlit ─────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_THEME_BASE=light
SESSION_TIMEOUT_MINUTES=30

# ─── ETL Paths ─────────────────────────────────────────────
ETL_DATA_ROOT=/opt/airflow/data
ETL_RAW_PATH=/opt/airflow/data/raw
ETL_BRONZE_PATH=/opt/airflow/data/bronze
ETL_SILVER_PATH=/opt/airflow/data/silver
ETL_REJECTS_PATH=/opt/airflow/data/rejects
ETL_LOGS_PATH=/opt/airflow/data/logs
ETL_LOG_LEVEL=WARNING

# ─── PCWIN (SQL Server SRM) ────────────────────────────────
PCWIN_HOST=192.168.1.66
PCWIN_PORT=51433
PCWIN_DATABASE=ScadaNetDb
PCWIN_USER=srm_pcwin_user
PCWIN_PASSWORD=srm_pcwin_password
PCWIN_DRIVER=pymssql
PCWIN_DATE_MIN=2026-01-01
PCWIN_CHUNK_SIZE=100000

# ─── Airflow System Variables ──────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DEFAULT_TIMEZONE=Africa/Casablanca
AIRFLOW_UID=50000

# ─── Chemins des sources brutes (Partages réseaux SRM) ──────
# Remplacer ci-dessous par les vrais montages/partages réseaux de SRM
PATH_RAW_PMAC=/opt/airflow/data/raw/pmac
PATH_RAW_GSTCOM=/opt/airflow/data/raw/gstcom
PATH_RAW_INDICATEURS_RECLAMATIONS=/opt/airflow/data/raw/indicateurs_reclamations
PATH_RAW_RENDEMENTS=/opt/airflow/data/raw/rendements
PATH_RAW_REFERENTIELS=/opt/airflow/data/raw/referentiels

# ─── Airflow - SMTP ────────────────────────────────────────
AIRFLOW__EMAIL__EMAIL_BACKEND=airflow.utils.email.send_email_smtp
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=bouachrinyassin0@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=fsts bres wczv lxag
AIRFLOW__SMTP__SMTP_MAIL_FROM=bouachrinyassin0@gmail.com