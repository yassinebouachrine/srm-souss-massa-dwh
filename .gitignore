# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ─── Environnements virtuels ──────────────────────────────
venv/
env/
.venv/
ENV/

# ─── Variables d'environnement ────────────────────────────
.env
.env.local
.env.example
# .env.production
# .env.docker
*.pem
*.key

# ─── IDE ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Streamlit ────────────────────────────────────────────
.streamlit/secrets.toml

