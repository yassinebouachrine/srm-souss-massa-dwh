# ═══════════════════════════════════════════════════════════
# SRM Souss-Massa - Git Ignore
# ═══════════════════════════════════════════════════════════

# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ─── Environnements virtuels ──────────────────────────────
venv/
env/
.venv/
ENV/

# ─── Variables d'environnement ────────────────────────────
.env
.env.local
.env.production
*.pem
*.key

# ─── IDE ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Streamlit ────────────────────────────────────────────
.streamlit/secrets.toml

# ─── Data (à ajuster en Partie 2) ─────────────────────────
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ─── Logs ─────────────────────────────────────────────────
*.log
logs/

# ─── PostgreSQL ───────────────────────────────────────────
*.dump
*.sql.gz

# ─── OS ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini