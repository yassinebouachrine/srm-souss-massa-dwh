# ═══════════════════════════════════════════════════════════
# SRM Souss-Massa - Git Ignore (Version Finale Prod)
# ═══════════════════════════════════════════════════════════

# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ─── Environnements virtuels ──────────────────────────────
venv/
env/
.venv/
ENV/
airflow_env/

# ─── Variables d'environnement & Secrets (NE PAS COMMITTER) ──
.env
.env.local
.env.docker
.env.production
.env.staging
*.pem
*.key

# Conserver uniquement le template d'exemple
!.env.example

# ─── IDE & OS ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Streamlit ────────────────────────────────────────────
.streamlit/secrets.toml

# ─── Données ETL (Exclure les données sensibles/lourdes) ────
data/raw/**/*.xlsx
data/raw/**/*.csv
data/raw/**/*.txt
data/bronze/
data/silver/
data/rejects/
data/logs/

# Conserver la structure des dossiers via .gitkeep
!data/raw/**/.gitkeep
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/rejects/.gitkeep
!data/logs/.gitkeep

# ─── Logs & Backups ───────────────────────────────────────
*.log
logs/
airflow/logs/
*.dump
*.sql.gz